# Konfigurasi contoh V2. Salin menjadi `.env` lalu isi nilainya.
# JANGAN commit file `.env` asli (sudah masuk .gitignore).

# --- Server ---
HOST=127.0.0.1
PORT=8010
DEBUG=false

# --- Database & folder kerja (relatif terhadap folder Dev2/) ---
DATABASE_PATH=data/absensi_v2.db
EXPORT_DIR=exports
LOG_DIR=logs
# Opsional: gunakan PostgreSQL (perubahan minimal pada lapisan akses data).
# DATABASE_URL=postgresql://user:password@localhost:5432/absensi_v2

# --- Artefak model wajah (opsional, READ-ONLY) ---
# Bila `gallery.npz` tidak tersedia, aplikasi berjalan dalam mode galeri DB saja
# (mahasiswa didaftarkan wajahnya melalui menu Admin -> Mahasiswa -> Daftarkan wajah).
# Bila `inception_resnet_v1_vggface2.pt` tidak ada, model mengunduh bobot VGGFace2 otomatis.
MODEL_DATA_ROOT=artifacts
MODEL_WEIGHTS_ROOT=model
GALLERY_NPZ=artifacts/gallery.npz
GALLERY_META=artifacts/gallery_meta.json
THRESHOLD_FILE=artifacts/threshold.txt
MODEL_PT=model/inception_resnet_v1_vggface2.pt
MODEL_NUM_CLASSES=8631
DEFAULT_THRESHOLD=0.695
# Paksa CPU bila GPU tidak tersedia / dipakai proses lain.
# FACE_DEVICE=cpu
# Muat model saat startup (false untuk pengujian cepat).
LOAD_ENGINE_ON_STARTUP=true

# --- Keamanan ---
# WAJIB diisi untuk produksi. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ubah-ini-dengan-string-acak-panjang
SESSION_HOURS=12
# Set true bila aplikasi dilayani lewat HTTPS.
COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=10

# --- Kebijakan aplikasi ---
# Halaman absensi publik (mahasiswa tanpa login).
PUBLIC_ATTENDANCE_ENABLED=true
# Admin boleh mendaftarkan wajah baru (embedding disimpan di DB V2).
ALLOW_FACE_ENROLLMENT=true

# --- Pipeline inferensi ---
MAX_FACES_PER_FRAME=12
MAX_FRAME_BYTES=4194304
MAX_IMAGE_DIM=1600
# Jeda minimum antar inferensi (ms) — 0 = tanpa jeda tambahan.
INFER_MIN_INTERVAL_MS=0
# Masa pendinginan per identitas (detik) sebelum diproses ulang.
IDENTITY_COOLDOWN_SECONDS=3

# --- Rate limiting (per jendela waktu, detik) ---
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW=60
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/absensi_v2.log
